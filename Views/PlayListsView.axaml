<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="MusicPlayer.Views.PlayListsView">

    <StackPanel Spacing="15" Margin="25">

        <TextBlock
            Text="Your Playlists"
            FontSize="28"
            FontWeight="Bold"/>

        <TextBlock
            Text="Your music collections will appear here."
            FontSize="14"/>

    </StackPanel>

</UserControl>